# Copy to .env and fill in real values. See DEPLOY.md section 3 for details.

# PhonePe v2 Standard Checkout (api/phonepe_client.php, payments.php, paymentConfirmation.php)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_VERSION=1
PHONEPE_CLIENT_SECRET=
PHONEPE_ENV=SANDBOX
PHONEPE_MERCHANT_ID=
# Where to send user after payment (e.g. your payment_callback.php URL)
PHONEPE_REDIRECT_URL=
# Frontend base URL for success/fail pages (where payment-success.html / payment-failed.html live)
PAYMENT_CALLBACK_BASE_URL=

# Webhook (api/payment_webhook.php): same username/password configured in the
# PhonePe dashboard (Developer Settings > Webhook, Authentication Type: SHA).
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Database (api/db.php and every API)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=zencareservice_servicy

# Admin-Token header for the legacy api/admin/*.php and api/payments.php GET list (leave empty to disable)
ADMIN_SECRET=

# Timezone for the admin API, coupons and the cron script
APP_TIMEZONE=Asia/Kolkata

# New app reviews (api/rating.php): false = Pending until an admin approves, true = Approved immediately
REVIEWS_AUTO_APPROVE=false

# Legacy app endpoints (api/legacy_access.php): true = customer login token required and
# customers can only read/change their own bookings and transactions; false = unchanged behaviour
LEGACY_STRICT_AUTH=false
# api/admin/assignTechnician.php: true = assign only the given booking, send the OTP by SMS and
# never return it; false = original behaviour (all of the customer's bookings, OTP in the response)
LEGACY_ASSIGN_STRICT=false

# true shows PHP errors in the browser (local debugging only); keep false in production
APP_DEBUG=false
# Folder for the PHP error log (absolute path, outside the web root if possible); default: logs/
APP_LOG_DIR=

# Receipt link prefix used by api/user_transaction.php. Optional: when empty it
# falls back to https://<request host>/api/order_details.php?order_id=
RECEIPT_BASE_URL=

# Admin notifications / SMS campaigns (optional)
SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_SENDER=
SMS_GATEWAY_PEID=
