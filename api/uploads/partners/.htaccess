# Partner KYC documents (Aadhaar, PAN, photos) from api/partner_registration.php.
# Never served over the web; staff read them from the server, not by URL.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes
